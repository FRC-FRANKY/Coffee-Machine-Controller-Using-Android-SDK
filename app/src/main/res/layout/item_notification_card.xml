<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Icon -->
        <ImageView
            android:id="@+id/ivNotificationIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_brewing"
            android:contentDescription="Notification Icon"
            android:layout_marginEnd="12dp"/>

        <!-- Texts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Coffee Is Ready!"
                android:textSize="14sp"
                android:textColor="@color/primary_brown"
                android:fontFamily="@font/grandstander_medium"/>

            <TextView
                android:id="@+id/tvNotificationMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get your coffee before it gets cold! :3"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/grandstander_medium"/>
        </LinearLayout>

        <!-- Read Status Indicator -->
        <View
            android:id="@+id/viewStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_status"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
