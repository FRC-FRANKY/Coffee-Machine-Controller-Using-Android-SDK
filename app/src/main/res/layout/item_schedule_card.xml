<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/autobrewScheduleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Time Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvLabelTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time:"
                android:textStyle="bold"
                android:textColor="@color/americano"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:fontFamily="@font/grandstander_medium"/>

            <TextView
                android:id="@+id/tvScheduleTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7:00 AM"
                android:textColor="@color/americano"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/tvLabelTime"
                app:layout_constraintTop_toTopOf="parent"
                android:fontFamily="@font/grandstander_medium"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <Switch
                android:id="@+id/switchScheduleEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:thumbTint="@color/caramel1"
                android:trackTint="@color/coffee1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Repeat Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat:"
                android:textStyle="bold"
                android:textColor="@color/americano"
                android:textSize="16sp"
                android:fontFamily="@font/grandstander_medium"/>

            <TextView
                android:id="@+id/tvScheduleRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily"
                android:layout_marginStart="8dp"
                android:textColor="@color/americano"
                android:textSize="16sp"
                android:fontFamily="@font/grandstander_medium"/>
        </LinearLayout>

        <!-- Bottom Row (Buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:baselineAligned="false">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                android:textStyle="bold"
                android:textColor="@color/milk"
                android:background="@drawable/button_rounded"
                android:backgroundTint="@color/caramel1" />

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textStyle="bold"
                android:textColor="@color/milk"
                android:background="@drawable/button_rounded"
                android:backgroundTint="@color/caramel1" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
